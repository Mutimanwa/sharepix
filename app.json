{
  "expo": {
    "name": "SharePix",
    "slug": "sharepix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sharepix-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/sharepix-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E3A3E"
    },
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.sharepix.mobile" },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E3A3E",
        "foregroundImage": "./assets/sharepix-logo.png"
      },
      "package": "app.sharepix.mobile"
    },
    "web": { "favicon": "./assets/sharepix-logo.png" },
    "plugins": ["expo-image-picker"]
  }
}
