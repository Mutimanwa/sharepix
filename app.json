{
  "expo": {
    "name": "SharePix",
    "slug": "sharepix",
    "scheme": "sharepix",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/sharepix-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sharepix.mobile",
      "deploymentTarget": "16.4"
    },
    "android": {
      "package": "app.sharepix.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F3F8F8",
        "foregroundImage": "./assets/sharepix-icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/sharepix-icon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser SharePix à utiliser la caméra pour scanner un album",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser SharePix à choisir les photos à partager dans un album.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F8F8",
          "image": "./assets/sharepix-logo.png",
          "imageWidth": 200
        }
      ],
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Autoriser SharePix à enregistrer les photos dans votre galerie.",
          "savePhotosPermission": "Autoriser SharePix à sauvegarder les photos dans votre galerie.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#164E52",
          "defaultChannel": "sharepix-activity"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "calvindev",
          "project": "sharepix",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dfb1170a-ddf5-446e-bc7a-1f62c0efec71"
      }
    }
  }
}
